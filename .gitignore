# ==========================================
# StaySphere - Git Ignore
# React + Vite + Python Flask + MySQL
# ==========================================

# React / Node.js
node_modules/
**/node_modules/
dist/
**/dist/
build/
.vite/
coverage/

# Python / Flask
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Python virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Local IDE settings
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary and backup files
*.tmp
*.bak
*.backup
*.zip

# Local database backups
*.sql.gz
*.dump

# ==========================================
# KEEP THESE FILES ON GITHUB
# ==========================================

!README.md
!docs/
!docs/**
!database/
!database/*.sql
